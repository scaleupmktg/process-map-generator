# --- Anthropic (extraction) ---
# Required for real extraction. Without it, /api/extract returns a clear
# "no model configured" error (503) — it will NOT silently produce a fake map.
ANTHROPIC_API_KEY=
# Default is Sonnet (sharper on long, exception-heavy processes). Use
# claude-haiku-4-5-20251001 for a cheaper/faster option on simpler inputs.
ANTHROPIC_MODEL=claude-sonnet-5

# Offline demo only: set to 1 to use the naive built-in mock extractor when no
# ANTHROPIC_API_KEY is set (dev/testing). Never enable in production.
PMG_MOCK_EXTRACT=

# --- Lead capture webhook (Airtable / CRM / Resend) ---
# If unset, /api/lead logs the lead and still returns 200 (never blocks a download).
LEAD_WEBHOOK_URL=

# --- Rate limiting (Upstash Redis, free tier) ---
# If unset, an in-memory per-instance limiter is used (dev only; not durable).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CTA ---
NEXT_PUBLIC_BOOKING_URL=https://growthrivescale.com/book

# --- Skill bundle (optional). If unset, the repo's /skill copy is used. ---
SKILL_BUNDLE_URL=
SKILL_CACHE_TTL=300

# --- Analytics (optional). If unset, events are logged to the server console. ---
ANALYTICS_WEBHOOK_URL=
